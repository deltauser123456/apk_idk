rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function member(chatId) {
      return signedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantUIDs;
    }
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid &&
        request.resource.data.email == request.auth.token.email;
    }
    match /chats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participantUIDs;
      allow create: if signedIn() &&
        request.resource.data.participantUIDs is list &&
        request.resource.data.participantUIDs.size() == 2 &&
        request.auth.uid in request.resource.data.participantUIDs;
      allow update: if signedIn() && request.auth.uid in resource.data.participantUIDs;
      allow delete: if false;
      match /messages/{messageId} {
        allow read: if member(chatId);
        allow create: if member(chatId) &&
          request.resource.data.senderUID == request.auth.uid &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 4000;
        allow update, delete: if false;
      }
    }
  }
}
